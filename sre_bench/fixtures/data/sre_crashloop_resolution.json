{
  "scenario_id": "sre_crashloop_resolution",
  "prompt": "The pod api-server in namespace production is crash-looping. Diagnose the root cause and resolve it.",
  "cluster": {
    "pods": [
      {
        "name": "api-server-7d9f8c-x2x4v",
        "namespace": "production",
        "phase": "CrashLoopBackOff",
        "restarts": 17,
        "cpu": "5m",
        "memory": "120Mi",
        "containers": [
          {
            "name": "api-server",
            "image": "registry.local/api-server:2.4.1",
            "ready": false
          }
        ],
        "env": [
          {
            "name": "DB_HOST",
            "value": "db-service.production.svc"
          },
          {
            "name": "DB_PORT",
            "value": "5433"
          }
        ],
        "logs": "connecting to db-service.production.svc:5433...\nconnection refused\nFATAL: could not establish database connection after 5 attempts, exiting\n",
        "metadata": {
          "name": "api-server-7d9f8c-x2x4v",
          "namespace": "production",
          "uid": "pod-api-server",
          "ownerReferences": [
            {
              "apiVersion": "apps/v1",
              "kind": "ReplicaSet",
              "name": "api-server-7d9f8c",
              "uid": "rs-api-server",
              "controller": true
            }
          ]
        },
        "note": "Container environment loaded db-config before its DB_PORT was reverted at 09:41; environment remains unchanged across container restarts."
      },
      {
        "name": "db-postgres-0",
        "namespace": "production",
        "phase": "Running",
        "restarts": 0,
        "cpu": "230m",
        "memory": "800Mi",
        "containers": [
          {
            "name": "postgres",
            "image": "registry.local/postgres:15",
            "ready": true
          }
        ],
        "logs": "database system is ready to accept connections\nlistening on 5432\n",
        "metadata": {
          "name": "db-postgres-0",
          "namespace": "production",
          "uid": "pod-postgres",
          "ownerReferences": [
            {
              "apiVersion": "apps/v1",
              "kind": "StatefulSet",
              "name": "db-postgres",
              "uid": "sts-postgres",
              "controller": true
            }
          ],
          "labels": {
            "app": "db-postgres"
          }
        }
      }
    ],
    "deployments": [
      {
        "name": "api-server",
        "namespace": "production",
        "replicas": 1,
        "ready_replicas": 0,
        "image": "registry.local/api-server:2.4.1",
        "metadata": {
          "name": "api-server",
          "namespace": "production",
          "uid": "deployment-api-server"
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "api-server",
                  "envFrom": [
                    {
                      "configMapRef": {
                        "name": "db-config"
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    ],
    "events": [
      {
        "namespace": "production",
        "type": "Warning",
        "reason": "BackOff",
        "object": "pod/api-server-7d9f8c-x2x4v",
        "message": "Back-off restarting failed container"
      },
      {
        "namespace": "production",
        "type": "Normal",
        "reason": "ConfigMapUpdated",
        "object": "configmap/db-config",
        "message": "port reverted 5433 -> 5432 at 09:41"
      }
    ],
    "nodes": [
      {
        "name": "worker-1",
        "status": "Ready",
        "cpu_pct": 42,
        "memory_pct": 51
      }
    ],
    "replicasets": [
      {
        "name": "api-server-7d9f8c",
        "namespace": "production",
        "metadata": {
          "name": "api-server-7d9f8c",
          "namespace": "production",
          "uid": "rs-api-server",
          "ownerReferences": [
            {
              "apiVersion": "apps/v1",
              "kind": "Deployment",
              "name": "api-server",
              "uid": "deployment-api-server",
              "controller": true
            }
          ]
        }
      }
    ],
    "statefulsets": [
      {
        "name": "db-postgres",
        "namespace": "production",
        "metadata": {
          "name": "db-postgres",
          "namespace": "production",
          "uid": "sts-postgres"
        }
      }
    ],
    "configmaps": [
      {
        "name": "db-config",
        "namespace": "production",
        "data": {
          "DB_HOST": "db-service.production.svc",
          "DB_PORT": "5432"
        },
        "metadata": {
          "name": "db-config",
          "namespace": "production",
          "uid": "config-db"
        }
      }
    ],
    "services": [
      {
        "name": "db-service",
        "namespace": "production",
        "spec": {
          "selector": {
            "app": "db-postgres"
          },
          "ports": [
            {
              "port": 5432,
              "targetPort": 5432
            }
          ]
        },
        "metadata": {
          "name": "db-service",
          "namespace": "production",
          "uid": "service-db"
        }
      }
    ]
  },
  "remediation": {
    "tool": "restart_deployment",
    "args": {
      "namespace": "production",
      "name": "api-server"
    },
    "heals": [
      {
        "kind": "pods",
        "name": "api-server-7d9f8c-x2x4v",
        "set": {
          "phase": "Running",
          "restarts": 0,
          "logs": "connecting to db-service.production.svc:5432...\nconnected\nserver started on :8080\nreadiness probe ok\n",
          "containers": [
            {
              "name": "api-server",
              "image": "registry.local/api-server:2.4.1",
              "ready": true
            }
          ],
          "env": [
            {
              "name": "DB_HOST",
              "value": "db-service.production.svc"
            },
            {
              "name": "DB_PORT",
              "value": "5432"
            }
          ],
          "note": "Replacement application container loaded the current db-config environment."
        }
      },
      {
        "kind": "deployments",
        "name": "api-server",
        "set": {
          "ready_replicas": 1
        }
      }
    ]
  }
}
